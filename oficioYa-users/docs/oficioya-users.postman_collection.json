{
  "info": {
    "name": "OficioYa - Usuarios",
    "description": "CRUD del microservicio de usuarios con escenarios de éxito y error. Ejecutar en orden (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera tokens JWT (HS256) con la misma clave del .env (variable jwtSecret)",
          "function b64url(words) {",
          "    return CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function jwt(sub, roles) {",
          "    const header = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "    const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({",
          "        sub: sub, roles: roles, exp: Math.floor(Date.now() / 1000) + 3600",
          "    })));",
          "    const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, pm.collectionVariables.get('jwtSecret')));",
          "    return header + '.' + payload + '.' + signature;",
          "}",
          "const userId = pm.collectionVariables.get('userId') || '00000000-0000-0000-0000-000000000000';",
          "pm.collectionVariables.set('userToken', jwt(userId, ['TRABAJADOR']));",
          "pm.collectionVariables.set('adminToken', jwt('11111111-1111-1111-1111-111111111111', ['ADMIN']));"
        ]
      }
    }
  ],
